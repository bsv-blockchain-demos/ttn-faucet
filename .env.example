# @bsv/wallet-toolbox version actually installed (record here): 2.14.9

# ---- Networks ----
# The faucet pays out on every network whose {PREFIX}_ARCADE_URL is set (PREFIX: TESTNET, TTN, TSTN).
# Each enabled network needs its own ARCADE_URL, ARCADE_CHAINTRACKS_URL and WALLET_STORAGE_PATH.
# The page defaults to Testnet; API calls without a "network" go to Testnet if enabled, else the
# first enabled network.
#
# Root private key (32-byte hex) for the toolbox server wallet identity, shared by every network
# unless {PREFIX}_WALLET_ROOT_KEY_HEX overrides it. Generate once, keep secret.
WALLET_ROOT_KEY_HEX=

# Testnet
TESTNET_ARCADE_URL=https://arcade-v2-testnet-us-1.bsvblockchain.tech
TESTNET_ARCADE_CHAINTRACKS_URL=https://arcade-v2-testnet-us-1.bsvblockchain.tech/chaintracks/v2
TESTNET_WALLET_STORAGE_PATH=./data/wallet-testnet.sqlite
# Flat key holding coins to bring under wallet management — used ONLY by the bootstrap scripts.
TESTNET_TREASURY_WIF=

# Teratestnet
TTN_ARCADE_URL=
TTN_ARCADE_CHAINTRACKS_URL=
TTN_WALLET_STORAGE_PATH=./data/wallet-ttn.sqlite
TTN_TREASURY_WIF=

# Teranode STN (operator-run endpoints only)
TSTN_ARCADE_URL=
TSTN_ARCADE_CHAINTRACKS_URL=
TSTN_WALLET_STORAGE_PATH=./data/wallet-tstn.sqlite
TSTN_TREASURY_WIF=

# Legacy single-network config: unprefixed ARCADE_URL / ARCADE_CHAINTRACKS_URL /
# WALLET_STORAGE_PATH / TREASURY_WIF still configure Teratestnet when no TTN_* vars are set.

# Faucet policy DB (Prisma).
DATABASE_URL=file:./prisma/dev.db
# Cloudflare Turnstile keys.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Payout policy (satoshis).
FAUCET_PAYOUT_SATS=100000
FAUCET_MAX_SATS=1000000
# Rate limit: max claims per window per subject.
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=5
# Rate limiting is temporarily OFF (any value other than "false" disables it).
# Set RATE_LIMIT_DISABLED=false to re-enable the per-subject limits above.
RATE_LIMIT_DISABLED=true
# Bootstrap: split the swept treasury into this many parallel-spendable UTXOs.
BOOTSTRAP_SPLIT_COUNT=20
# Mobile wallet pairing (optional): base URL of the relay service in relay/ (see README).
# Unset = no QR fallback; the wallet tab shows "No BRC-100 wallet detected" instead.
RELAY_INTERNAL_URL=
