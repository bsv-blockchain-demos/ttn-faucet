{
  "name": "faucet-relay",
  "version": "0.2.2",
  "private": true,
  "description": "Mobile wallet pairing relay (@bsv/wallet-relay) for the Teratestnet faucet",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "SEE LICENSE IN ../LICENSE.txt",
  "dependencies": {
    "@bsv/sdk": "^2.8.11",
    "@bsv/wallet-relay": "^0.5.1",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
