# Relay identity key (32-byte hex). Generate once and keep it stable: its public key is embedded in
# every pairing QR and is the ECDH counterparty the phone encrypts to. Use a dedicated key, NOT the
# faucet treasury/wallet key.  Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_PRIVATE_KEY=
# Public https:// URL of the faucet website (bare origin). Embedded in the QR as the pairing origin;
# the phone fetches ${FAUCET_PUBLIC_URL}/api/session/:id, which the faucet proxies to this service.
FAUCET_PUBLIC_URL=https://faucet.example.com
# Public wss:// base URL of THIS service (bare origin, no /ws — the phone appends it).
# bsv-wallet rejects loopback/private hosts, so local dev needs a tunnel (e.g. ngrok).
RELAY_WS_URL=wss://relay.faucet.example.com
# In-cluster faucet base URL. The relay POSTs {FAUCET_INTERNAL_URL}/api/claim/mobile/:id the
# moment a phone connects, so the claim runs while the wallet is still open. Optional (the faucet
# also checks every 1.5s).
FAUCET_INTERNAL_URL=http://localhost:3000
# Deep-link scheme registered by the wallet app.
QR_SCHEMA=bsv-wallet
PORT=8787
